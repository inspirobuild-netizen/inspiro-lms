# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Database (Neon.tech) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/inspiro?sslmode=require

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                          # min 64 chars, random
JWT_REFRESH_SECRET=                  # min 64 chars, different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Bunny Stream ─────────────────────────────────────────────────────────────
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_WEBHOOK_SECRET=        # set in Bunny dashboard → Webhook → Notification Secret

# ─── Backblaze B2 ─────────────────────────────────────────────────────────────
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=

# ─── Agora ────────────────────────────────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Groq AI (Phase 2) ────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
SMS_PROVIDER=                        # e.g. twilio or msg91
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Razorpay (Phase 2) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
