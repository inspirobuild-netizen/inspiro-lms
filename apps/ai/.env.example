# Groq LLM
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings — OpenAI-compatible endpoint. Default = Jina (cheapest).
# To swap providers, change these three (keep dim 1024 to match pgvector column):
#   OpenAI: https://api.openai.com/v1 + text-embedding-3-small
#   Voyage: https://api.voyageai.com/v1 + voyage-3-lite (dim differs — remigrate)
EMBEDDINGS_BASE_URL=https://api.jina.ai/v1
EMBEDDINGS_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_DIM=1024

# Shared secret with the Node API (X-Internal-Key header). Generate:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Server
PORT=8000
ENVIRONMENT=development
