{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx drizzle/seed.ts",
    "db:migrate:http": "tsx drizzle/migrate-http.ts",
    "db:seed:http": "tsx drizzle/seed-http.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@sentry/node": "^8.0.0",
    "agora-token": "^2.0.5",
    "bullmq": "^5.8.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.3.2",
    "jose": "^5.4.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "socket.io": "^4.7.5",
    "undici": "^6.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.22.0",
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.2.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
