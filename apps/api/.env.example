# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/inspiro?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:pass@host:6379
REDIS_KEY_PREFIX=inspiro:

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-yyyyyyyyyyyyyyy
COOKIE_SECRET=change-me-min-32-chars-zzzzzzzzzzzzzzz

# ── OTP SMS ───────────────────────────────────────────────────────────────────
# msg91 (default, best for India) or twilio
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Only if SMS_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Bunny Stream ──────────────────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
# Register webhook in Bunny as: https://<api-host>/api/v1/webhooks/bunny?token=<this value>
BUNNY_WEBHOOK_SECRET=

# ── Bunny Storage (optional — PDFs/notes) ─────────────────────────────────────
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=inspiro-storage
BUNNY_PULL_ZONE_URL=

# ── Agora Live Class ──────────────────────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Firebase / FCM ────────────────────────────────────────────────────────────
# Paste the entire service-account JSON as a single-line string (escape inner quotes)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"inspiro-xxx",...}

# ── AI Service (optional — doubts escalate to mentors when unset) ────────────
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=same-value-as-apps-ai-INTERNAL_API_KEY
# Optional override — defaults to PIB + The Hindu national feeds
CA_RSS_FEEDS=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
